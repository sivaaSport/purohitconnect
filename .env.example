# PurohitConnect Environment Configuration
# Copy this file to .env and fill in your actual values

# Django Configuration
SECRET_KEY=your-very-long-random-secret-key-here-change-this-in-production
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=purohitconnect.com,www.purohitconnect.com

# Database Configuration
# For PostgreSQL (recommended for production):
DATABASE_URL=postgresql://username:password@localhost:5432/purohitconnect_db
# For SQLite (development only):
# DATABASE_URL=sqlite:///db.sqlite3

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_live_key_id_here
RAZORPAY_KEY_SECRET=your_live_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Dev only — keep False in production
RAZORPAY_ALLOW_MOCK=False

# RazorpayX Payouts (required for automated bank withdrawals)
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_current_account_number
RAZORPAYX_PAYOUT_MODE=IMPS
# Require admin-verified bank account before payout
WITHDRAWAL_REQUIRE_VERIFIED_BANK=True
# Auto-initiate RazorpayX payout without admin approval (keep False in production)
WITHDRAWAL_AUTO_PAYOUT=False

# Twilio SMS Configuration (optional, for OTP SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
# WhatsApp sender (Twilio sandbox or approved business number)
# Example sandbox: +14155238886  OR  whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=+14155238886
# In production this defaults to False via production.py
TWILIO_ALLOW_MOCK=False

# Email Configuration (for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@purohitconnect.com

# Security Settings (for production)
CSRF_TRUSTED_ORIGINS=https://purohitconnect.com,https://www.purohitconnect.com
# Flutter web / hosted app origins that may call /api/v1/
CORS_ALLOWED_ORIGINS=https://app.purohitconnect.com,http://localhost:5173
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# File Storage (optional, for cloud storage)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_S3_REGION_NAME=us-east-1

# Redis/Cache Configuration (optional)
# REDIS_URL=redis://localhost:6379/1
# CACHE_URL=redis://localhost:6379/2

# Logging Configuration (optional)
# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn-here

# Admin Configuration
DJANGO_ADMIN_URL=admin/

# Performance Settings
# GUNICORN_WORKERS=4
# GUNICORN_BIND=0.0.0.0:8000
